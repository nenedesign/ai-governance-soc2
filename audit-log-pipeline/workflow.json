        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ audit_id: $(\"Generate Audit Entry\").first().json.audit_id, status: \"logged\", integrity_hash: $(\"Generate Audit Entry\").first().json.integrity_hash }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "c7043750-49f7-4f81-8155-5d6accd163e4",
